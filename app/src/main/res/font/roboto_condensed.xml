<?xml version="1.0" encoding="utf-8"?>
<!-- The compact typeface experiment, bundled edition. Regular-weight requests resolve to the
     Medium cut: the owner wanted the narrow face sturdy, not thin, and the static system
     sans-serif-condensed has no medium weight to compose with. Bold requests use the real
     bold. Pre-API-26 AppCompat picks entries by style and cannot vary weight, so old devices
     render everything in the Medium cut. The fonts and the OFL licence (res/raw) are Google
     Fonts' Roboto Condensed v31, subsets requested per weight from the CSS API. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <font
        android:fontWeight="400"
        android:fontStyle="normal"
        android:font="@font/roboto_condensed_medium"
        app:fontWeight="400"
        app:fontStyle="normal"
        app:font="@font/roboto_condensed_medium" />

    <font
        android:fontWeight="700"
        android:fontStyle="normal"
        android:font="@font/roboto_condensed_bold"
        app:fontWeight="700"
        app:fontStyle="normal"
        app:font="@font/roboto_condensed_bold" />
</font-family>
