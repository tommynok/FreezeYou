<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <ImageView
        android:id="@+id/app_lock_main_logo_imageView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentTop="true"
        android:layout_above="@id/app_lock_main_fingerprint_imageButton"
        android:contentDescription="@string/unlock"
        android:padding="32dp"
        android:scaleType="fitCenter"
        app:srcCompat="@mipmap/ic_launcher_new_round" />

    <ImageButton
        android:id="@+id/app_lock_main_fingerprint_imageButton"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_above="@id/app_lock_main_unlock_button"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="16dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/unlock"
        android:scaleType="fitCenter"
        app:srcCompat="?android:attr/fingerprintAuthDrawable"
        app:tint="?attr/colorAccent" />

    <Button
        android:id="@+id/app_lock_main_unlock_button"
        style="@style/Widget.App.Button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="16dp"
        android:minWidth="160dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:text="@string/unlock" />
</RelativeLayout>
