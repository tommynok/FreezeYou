<?xml version="1.0" encoding="utf-8"?>
<!-- What is left here after the coloured themes were deleted: the two translucent bases, and
     nothing else. This file used to carry some eighty lines of commented-out palette dialogs
     (AppTheme.Default.Dialog.Blue and its five siblings); they were dead even before the palettes
     were removed from the menu, and a style kept in a comment is a style somebody eventually
     uncomments. -->
<resources>

    <style name="Base.AppTheme.Translucent.NoTitleBar" parent="Base.V19.AppTheme.Translucent.NoTitleBar" />

    <style name="Base.V19.AppTheme.Translucent.NoTitleBar" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
    </style>

</resources>
