<?xml version="1.0" encoding="utf-8"?>
<!-- The compact typeface experiment, bundled edition. The variable font carries the full
     Cyrillic coverage (the per-weight CSS instances are Latin-only subsets, which made every
     Cyrillic string fall back to the system font - the mixed look the owner reported).
     Regular-weight requests resolve to a wght=430 instance: 500 measured 28% more ink
     than the stock regular (pixel comparison of identical menu items), 400 read as fragile;
     430 is the middle of the owner's two data points. Pre-API-26 AppCompat cannot vary weight, so old devices render
     the file's default 400 instance. Font and licence (res/raw) are Google Fonts' Roboto
     Condensed v31. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <font
        android:fontWeight="400"
        android:fontStyle="normal"
        android:font="@font/roboto_condensed_var"
        android:fontVariationSettings="'wght' 430"
        app:fontWeight="400"
        app:fontStyle="normal"
        app:font="@font/roboto_condensed_var"
        app:fontVariationSettings="'wght' 430" />

    <font
        android:fontWeight="700"
        android:fontStyle="normal"
        android:font="@font/roboto_condensed_var"
        android:fontVariationSettings="'wght' 700"
        app:fontWeight="700"
        app:fontStyle="normal"
        app:font="@font/roboto_condensed_var"
        app:fontVariationSettings="'wght' 700" />
</font-family>
