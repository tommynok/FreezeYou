<?xml version="1.0" encoding="utf-8"?>
<!-- API 26+ only: the framework resolves @font references natively here. Below v26 the
     values/ styles keep the system sans-serif-condensed string, and Robolectric's old-SDK
     shadows (which cannot create native FontFamily from resources) stay out of the crash path. -->
<resources>

        <!-- The app's own type scale, one step taller than Material3's. The sizes were never
             ours - every style above inherited them, and the owner read the result as small text:
             the letters are 15% narrower at the same height, so the lines are short and the text
             looks denser than it is tall. Raising the size rather than the width keeps the
             condensed footprint the compact look was asked for. -->
    <style name="TextAppearance.App.DisplayLarge" parent="TextAppearance.Material3.DisplayLarge">
        <item name="android:fontFamily">@font/fira_condensed</item>
        <item name="fontFamily">@font/fira_condensed</item>
        <item name="android:textSize">61sp</item>
    </style>

    <style name="TextAppearance.App.DisplayMedium" parent="TextAppearance.Material3.DisplayMedium">
        <item name="android:fontFamily">@font/fira_condensed</item>
        <item name="fontFamily">@font/fira_condensed</item>
        <item name="android:textSize">48sp</item>
    </style>

    <style name="TextAppearance.App.DisplaySmall" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:fontFamily">@font/fira_condensed</item>
        <item name="fontFamily">@font/fira_condensed</item>
        <item name="android:textSize">38sp</item>
    </style>

    <style name="TextAppearance.App.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:fontFamily">@font/fira_condensed</item>
        <item name="fontFamily">@font/fira_condensed</item>
        <item name="android:textSize">34sp</item>
    </style>

    <style name="TextAppearance.App.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">@font/fira_condensed</item>
        <item name="fontFamily">@font/fira_condensed</item>
        <item name="android:textSize">30sp</item>
    </style>

    <style name="TextAppearance.App.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">@font/fira_condensed</item>
        <item name="fontFamily">@font/fira_condensed</item>
        <item name="android:textSize">26sp</item>
    </style>

    <style name="TextAppearance.App.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/fira_condensed</item>
        <item name="fontFamily">@font/fira_condensed</item>
        <item name="android:textSize">24sp</item>
    </style>

    <style name="TextAppearance.App.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">@font/fira_condensed</item>
        <item name="fontFamily">@font/fira_condensed</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="TextAppearance.App.TitleSmall" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:fontFamily">@font/fira_condensed</item>
        <item name="fontFamily">@font/fira_condensed</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="TextAppearance.App.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">@font/fira_condensed</item>
        <item name="fontFamily">@font/fira_condensed</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="TextAppearance.App.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/fira_condensed</item>
        <item name="fontFamily">@font/fira_condensed</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="TextAppearance.App.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">@font/fira_condensed</item>
        <item name="fontFamily">@font/fira_condensed</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="TextAppearance.App.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">@font/fira_condensed</item>
        <item name="fontFamily">@font/fira_condensed</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="TextAppearance.App.LabelMedium" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">@font/fira_condensed</item>
        <item name="fontFamily">@font/fira_condensed</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="TextAppearance.App.LabelSmall" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">@font/fira_condensed</item>
        <item name="fontFamily">@font/fira_condensed</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="TextAppearance.App.PopupMenu.Dark" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/appOnDarkSurface</item>
        <item name="android:fontFamily">@font/fira_condensed</item>
        <item name="fontFamily">@font/fira_condensed</item>
    </style>

    <style name="TextAppearance.App.PopupMenu.Light" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">@font/fira_condensed</item>
        <item name="fontFamily">@font/fira_condensed</item>
    </style>

    <!-- The app-wide typeface on API 26+, where the framework resolves @font natively. This is the
         same leaf style values/ declares - a same-named style here replaces that one entirely - so
         the font is the only thing that changes with the API level and the rest of each theme still
         arrives through its .Core parent. Without this file the theme-level font stayed the system
         string on every device, and the text that does not come through one of the appearances above
         (plain views, fields, the labels of switches and checkboxes) kept the system condensed while
         the buttons and the dialogs had the bundled one: two typefaces in one row. Below 26 nothing
         here applies and the theme keeps the system family, which is also what keeps Robolectric's
         old-SDK shadows out of the way. -->
    <style name="Base.AppTheme.Dark" parent="Base.AppTheme.Dark.Core">
        <item name="android:fontFamily">@font/fira_condensed</item>
        <item name="fontFamily">@font/fira_condensed</item>
    </style>

    <style name="Base.AppTheme.Dark.Dialog" parent="Base.AppTheme.Dark.Dialog.Core">
        <item name="android:fontFamily">@font/fira_condensed</item>
        <item name="fontFamily">@font/fira_condensed</item>
    </style>

    <style name="Base.AppTheme.Light.DarkActionBar" parent="Base.AppTheme.Light.DarkActionBar.Core">
        <item name="android:fontFamily">@font/fira_condensed</item>
        <item name="fontFamily">@font/fira_condensed</item>
    </style>

    <style name="Base.AppTheme.Light" parent="Base.AppTheme.Light.Core">
        <item name="android:fontFamily">@font/fira_condensed</item>
        <item name="fontFamily">@font/fira_condensed</item>
    </style>

    <style name="Base.AppTheme.Light.Dialog" parent="Base.AppTheme.Light.Dialog.Core">
        <item name="android:fontFamily">@font/fira_condensed</item>
        <item name="fontFamily">@font/fira_condensed</item>
    </style>

</resources>
