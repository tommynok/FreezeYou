<?xml version="1.0" encoding="utf-8"?><!--
    The list is built off the main thread, and for a package with hundreds of activities that
    takes a few seconds — during which an empty screen looks like the application hanging. The
    spinner sits on top of the list and goes away when the list arrives.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ListView
        android:id="@+id/staa_main_listView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:fastScrollEnabled="true" />

    <ProgressBar
        android:id="@+id/staa_main_loading_progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center" />

</FrameLayout>
