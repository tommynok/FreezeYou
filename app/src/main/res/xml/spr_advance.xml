<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- Installing packages through FreezeYou is a side line, not something reached daily. -->
    <Preference
        app:fragment="cf.playhi.freezeyou.ui.fragment.settings.SettingsInstallUninstallFragment"
        app:iconSpaceReserved="false"
        app:key="spr_installUninstall"
        app:singleLineTitle="false"
        app:summary="@string/summary_spr_installUninstall"
        app:title="@string/installAndUninstall" />
    <CheckBoxPreference
        app:defaultValue="false"
        app:iconSpaceReserved="false"
        app:key="DebugModeEnabled"
        app:singleLineTitle="false"
        app:summary="@string/debugModeSummary"
        app:title="@string/debugMode" />
    <EditTextPreference
        app:defaultValue="@string/app_name"
        app:iconSpaceReserved="false"
        app:key="organizationName"
        app:singleLineTitle="false"
        app:summary="@string/onlyMROOTModeUse"
        app:title="@string/organizationName"
        app:useSimpleSummaryProvider="true" />
    <Preference
        app:iconSpaceReserved="false"
        app:key="configureAccessibilityService"
        app:singleLineTitle="false"
        app:summary="@string/accessibility_service_description"
        app:title="@string/configureAccessibilityService" />
    <Preference
        app:iconSpaceReserved="false"
        app:singleLineTitle="false"
        app:title="@string/manualMode">
        <intent
            android:data="ManualMode"
            android:targetClass="cf.playhi.freezeyou.ui.ManualModeActivity"
            android:targetPackage="cf.playhi.freezeyou" />
    </Preference>
    <Preference
        app:iconSpaceReserved="false"
        app:singleLineTitle="false"
        app:title="@string/showLogcat">
        <intent
            android:targetClass="cf.playhi.freezeyou.ui.ShowLogcatActivity"
            android:targetPackage="cf.playhi.freezeyou" />
    </Preference>
    <!-- The danger zone keeps a screen of its own: a row that wipes data or revokes ownership
         should not sit one careless tap away from a debugging switch. A category around it would
         only repeat the row's own title, so the row stands on its own. -->
    <Preference
        app:fragment="cf.playhi.freezeyou.ui.fragment.settings.SettingsDangerZoneFragment"
        app:iconSpaceReserved="false"
        app:key="dangerZone"
        app:singleLineTitle="false"
        app:summary="@string/dangerZoneSummary"
        app:title="@string/dangerZone" />

    <!--        <Preference app:title="@string/commandExecutionTool">-->
    <!--            <intent-->
    <!--                app:targetClass="cf.playhi.freezeyou.CommandExecutorActivity"-->
    <!--                app:targetPackage="cf.playhi.freezeyou" />-->
    <!--        </Preference>-->

</PreferenceScreen>