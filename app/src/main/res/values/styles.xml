        <!-- The app-wide typeface, and the only thing about these themes that differs by API
             level. It lives in a style of its own because a same-named style in a version
             folder replaces this one entirely: the rest of the theme stays in the .Core style
             above, and values-v26 repoints just the font at the bundled family. -->
    <style name="Base.AppTheme.Light" parent="Base.AppTheme.Light.Core">
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="fontFamily">sans-serif-condensed</item>
    </style>

    <!-- The light theme, and it is the only light one: the coloured palettes (blue, yellow,
         orange, green, pink, red) used to be siblings here and are gone, since the menu stopped
         offering them in every language. Their values moved into this style, so below API 31 the
         theme resolves to exactly what it did before - the white palette WAS the light theme.
         colorPrimary is nearly white, so Material dialogs would print their action labels in it
         and they would be invisible on a light dialog; the overlay replaces that one colour with
         the accent. From Android 12 on this style is redefined in values-v31 as the Material3
         light theme. -->
    <style name="AppTheme.Default" parent="Base.AppTheme.Light">
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.App.Dialog.Light</item>
        <item name="colorPrimaryDark">#eeeeee</item>
        <item name="colorPrimary">#fafafa</item>
        <item name="colorAccent">#424242</item>
        <!-- #eeeeee is a light bar, so this one theme of the light family wants dark icons. -->
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Main alone uses the lighter popup and dialog surfaces; Settings keeps AppTheme.Default. -->
    <style name="AppTheme.Default.Main" parent="AppTheme.Default">
