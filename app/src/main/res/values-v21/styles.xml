<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Base.AppTheme.Translucent.NoTitleBar" parent="Base.V21.AppTheme.Translucent.NoTitleBar" />

    <style name="Base.V21.AppTheme.Translucent.NoTitleBar" parent="Base.V19.AppTheme.Translucent.NoTitleBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowContentTransitions">true</item>
    </style>

    <!-- Base.AppTheme.Dark, Base.AppTheme.Light and Base.AppTheme.Light.DarkActionBar used to be
         re-declared here with AppCompat parents. A same-named style in a qualifier folder
         replaces the base one completely, so on every device from API 21 up those three themes
         threw away their Material3 parents and every Material3 item with them - surfaces,
         shapes, popup and dialog styles. That is why dark and black ignored the rounding work
         no matter what the base file said, while the light theme (which is declared for API 31+
         in values-v31) looked right. The version-gated items they carried (the navigation bar
         colour, the light status bar) now live in the base styles themselves. -->

    <!-- The commented-out AppCompat themes that used to sit below that note are gone along with
         the coloured palettes: this file now carries the translucent bases and this explanation,
         which is worth keeping - the same-named-style trap is what the comment is about, and it
         will catch the next person who tries to "just add a v21 variant". -->

</resources>
