<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_logo"
        android:shortcutDisabledMessage="@string/app_name"
        android:shortcutId="main"
        android:shortcutLongLabel="@string/app_name"
        android:shortcutShortLabel="@string/app_name">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="cf.playhi.freezeyou.Main"
            android:targetPackage="cf.playhi.freezeyou" />
        <!-- If your shortcut is associated with multiple intents, include them
             here. The last intent in the list determines what the user sees when
             they launch this shortcut. -->
        <categories android:name="android.shortcut.conversation" />
    </shortcut>
    <!-- Specify more shortcuts here.
         "scheduledTasks" used to sit here: a launcher reads a static label straight from the APK
         with the system locale, so it stayed in the old language after a change inside the app.
         It is published as a dynamic shortcut by ShortcutTokenUtils, which builds the label
         through a context carrying the chosen locale. Only the app-name shortcut stays static. -->
</shortcuts>
