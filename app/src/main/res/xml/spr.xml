<?xml version="1.0" encoding="utf-8"?><!--
    Sixteen rows without a word of explanation, several of them leading to a screen with a single
    switch on it. Now the rows are grouped by what they are for, each says what is inside, and the
    screens holding one or two settings have been folded into the ones they belong with.
-->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:title="@string/category_settings">

        <Preference
            app:fragment="cf.playhi.freezeyou.ui.fragment.settings.SettingsMainScreenFragment"
            app:iconSpaceReserved="false"
            app:key="spr_mainScreen"
            app:singleLineTitle="false"
            app:summary="@string/summary_spr_mainScreen"
            app:title="@string/mainScreenSettings" />
        <Preference
            app:fragment="cf.playhi.freezeyou.ui.fragment.settings.SettingsAppearanceFragment"
            app:iconSpaceReserved="false"
            app:key="spr_appearance"
            app:singleLineTitle="false"
            app:summary="@string/summary_spr_appearance"
            app:title="@string/appearance" />
        <Preference
            app:fragment="cf.playhi.freezeyou.ui.fragment.settings.SettingsFufFragment"
            app:iconSpaceReserved="false"
            app:key="spr_fuf"
            app:singleLineTitle="false"
            app:summary="@string/summary_spr_fuf"
            app:title="@string/freezeAUF" />
        <Preference
            app:fragment="cf.playhi.freezeyou.ui.fragment.settings.SettingsAutomationFragment"
            app:iconSpaceReserved="false"
            app:key="spr_automation"
            app:singleLineTitle="false"
            app:summary="@string/summary_spr_automation"
            app:title="@string/automation" />
        <Preference
            app:fragment="cf.playhi.freezeyou.ui.fragment.settings.SettingsNotificationFragment"
            app:iconSpaceReserved="false"
            app:key="spr_notification"
            app:singleLineTitle="false"
            app:summary="@string/summary_spr_notification"
            app:title="@string/notificationBar" />
        <Preference
            app:fragment="cf.playhi.freezeyou.ui.fragment.settings.SettingsAccessFragment"
            app:iconSpaceReserved="false"
            app:key="spr_access"
            app:singleLineTitle="false"
            app:summary="@string/summary_spr_access"
            app:title="@string/accessAndSecurity" />

    </PreferenceCategory>

    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:title="@string/category_maintenance">

        <Preference
            app:fragment="cf.playhi.freezeyou.ui.fragment.settings.SettingsManageSpaceFragment"
            app:iconSpaceReserved="false"
            app:key="spr_manageSpace"
            app:singleLineTitle="false"
            app:summary="@string/summary_spr_manageSpace"
            app:title="@string/manageSpace" />
        <Preference
            app:iconSpaceReserved="false"
            app:key="backupAndRestore"
            app:singleLineTitle="false"
            app:title="@string/backupAndRestore" />
        <Preference
            app:iconSpaceReserved="false"
            app:singleLineTitle="false"
            app:title="@string/autoDiagnosis">
            <intent
                android:targetClass="cf.playhi.freezeyou.ui.AutoDiagnosisActivity"
                android:targetPackage="cf.playhi.freezeyou" />
        </Preference>
        <Preference
            app:fragment="cf.playhi.freezeyou.ui.fragment.settings.SettingsAdvanceFragment"
            app:iconSpaceReserved="false"
            app:key="spr_advance"
            app:singleLineTitle="false"
            app:summary="@string/summary_spr_advance"
            app:title="@string/advance" />

    </PreferenceCategory>

    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:title="@string/category_help">

        <Preference
            app:iconSpaceReserved="false"
            app:key="howToUse"
            app:singleLineTitle="false"
            app:summary="@string/summary_hToUse"
            app:title="@string/hToUse" />
        <Preference
            app:iconSpaceReserved="false"
            app:singleLineTitle="false"
            app:title="@string/about">
            <intent
                android:targetClass="cf.playhi.freezeyou.ui.AboutActivity"
                android:targetPackage="cf.playhi.freezeyou" />
        </Preference>

    </PreferenceCategory>

</PreferenceScreen>
