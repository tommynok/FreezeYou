<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <!-- Invisible expanded touch target: 44dp wide by 64dp tall -->
            <item>
                <shape android:shape="rectangle">
                    <size android:width="44dp" android:height="64dp" />
                    <solid android:color="@color/realTranslucent" />
                </shape>
            </item>
            <!-- Visible accented pill when dragging: 10dp wide with 3dp inset from screen edge -->
            <item
                android:bottom="2dp"
                android:left="31dp"
                android:right="3dp"
                android:top="2dp">
                <shape android:shape="rectangle">
                    <corners android:radius="5dp" />
                    <solid android:color="@color/appAccent" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <!-- Invisible expanded touch target: 44dp wide by 64dp tall -->
            <item>
                <shape android:shape="rectangle">
                    <size android:width="44dp" android:height="64dp" />
                    <solid android:color="@color/realTranslucent" />
                </shape>
            </item>
            <!-- Visible subtle pill when idle: 6dp wide with 3dp inset from screen edge -->
            <item
                android:bottom="2dp"
                android:left="35dp"
                android:right="3dp"
                android:top="2dp">
                <shape android:shape="rectangle">
                    <corners android:radius="3dp" />
                    <solid android:color="@color/translucentGreyBackground" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
