<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <Button
            android:id="@+id/bma_main_saveToFile_button"
            style="@style/Widget.AppCompat.Button.Colored"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/saveBackupToFile" />

        <Button
            android:id="@+id/bma_main_restoreFromFile_button"
            style="@style/Widget.AppCompat.Button.Colored"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/restoreBackupFromFile" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="10dp"
            android:background="?android:attr/listDivider" />

        <TextView
            android:id="@+id/bma_main_viaText_textView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="@string/backupViaTextHint"
            android:textSize="13sp" />

        <!-- Full width and stacked, in the order the steps are actually taken: produce the text,
             copy it out; paste one in, apply it. Side by side, the pairs came out at different
             widths as soon as a translation was longer than "Export". -->
        <Button
            android:id="@+id/bma_main_export_button"
            style="@style/Widget.AppCompat.Button.Colored"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/expt" />

        <Button
            android:id="@+id/bma_main_copy_button"
            style="@style/Widget.AppCompat.Button.Colored"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@android:string/copy" />

        <Button
            android:id="@+id/bma_main_paste_button"
            style="@style/Widget.AppCompat.Button.Colored"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@android:string/paste" />

        <Button
            android:id="@+id/bma_main_import_button"
            style="@style/Widget.AppCompat.Button.Colored"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/impt" />

        <!-- Fixed height, not wrap_content: a large backup blob would otherwise be laid out in
             full inside the ScrollView and freeze the UI. Scrolls internally instead. -->
        <EditText
            android:id="@+id/bma_main_inputAndoutput_editText"
            style="@style/Widget.AppCompat.EditText"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:gravity="start|top"
            android:inputType="textMultiLine"
            android:scrollbars="vertical"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
