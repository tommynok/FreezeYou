<?xml version="1.0" encoding="utf-8"?>
<!-- The compact typeface experiment, second candidate: Fira Sans Condensed instead of Roboto
     Condensed. Same wiring as the first one - only the family and the files differ, the styles
     and the revert recipe stay. Three cuts so the Material3 weight roles keep their contrast:
     regular text -> Regular, medium titles and labels -> Medium, bold -> Bold. (Routing the
     regular text to Medium made the whole app read bold in this face.) Full Cyrillic; the OFL
     licence is in res/raw. Google Fonts' Fira Sans Condensed v11. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <font
        android:fontWeight="400"
        android:fontStyle="normal"
        android:font="@font/fira_condensed_regular"
        app:fontWeight="400"
        app:fontStyle="normal"
        app:font="@font/fira_condensed_regular" />

    <font
        android:fontWeight="500"
        android:fontStyle="normal"
        android:font="@font/fira_condensed_medium"
        app:fontWeight="500"
        app:fontStyle="normal"
        app:font="@font/fira_condensed_medium" />

    <font
        android:fontWeight="700"
        android:fontStyle="normal"
        android:font="@font/fira_condensed_bold"
        app:fontWeight="700"
        app:fontStyle="normal"
        app:font="@font/fira_condensed_bold" />
</font-family>
