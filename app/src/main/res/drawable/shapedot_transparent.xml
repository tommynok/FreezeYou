<?xml version="1.0" encoding="utf-8"?><!--
    The "not frozen" counterpart of the status dot. It used to be painted in the window
    background colour so as to disappear into it, but a selected row is drawn on a grey
    highlight, and there the dot reappeared as a light circle — reading as a marker of its own
    right next to the dark one that means frozen. Drawing nothing has no such background to
    disagree with. The size and padding match the coloured dot so the row measures the same.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid
        android:color="@android:color/transparent" />
    <padding
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp" />
    <size
        android:width="10dp"
        android:height="10dp" />
</shape>
