<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- 12 dp corners: buttons and other small components. -->
    <style name="Shape.App.Small" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <!-- Tighter than the AppCompat default so 4 toolbar action icons can fit on more screens
         without shrinking below the ~40dp accessibility-friendly touch target. -->
    <style name="FreezeYou.ActionButton" parent="Widget.AppCompat.ActionButton">
        <item name="android:minWidth">40dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
    </style>

    <!-- Filled action buttons, including the six on the backup screen. They used to carry
         Widget.AppCompat.Button.Colored: that style sets android:background, and a Button in a
         Material theme is inflated as MaterialButton, which then treats the background as
         user-supplied and keeps the AppCompat shape - a rectangle with a 2 dp radius, whatever
         shapeAppearance says. Styling MaterialButton itself is what actually rounds it.

         The insets are part of the look, not a detail to optimise away. MaterialButton insets
         the fill from the edges of the touch target, and that inset is what separates two
         buttons that sit next to each other; zeroing it made the fills touch and read as one
         long bar. Top and bottom keep the Material3 default (m3_btn_inset, 4 dp), which is what
         separates the stacked buttons on the backup screen. Left and right are set here because
         every row of buttons in this app is a weight-split LinearLayout with no margins. -->
    <style name="Widget.App.Button" parent="Widget.Material3.Button">
        <item name="shapeAppearance">@style/Shape.App.Small</item>
        <item name="backgroundTint">?attr/colorAccent</item>
        <item name="android:textColor">@color/app_button_text</item>
        <item name="android:insetLeft">4dp</item>
        <item name="android:insetRight">4dp</item>
    </style>

    <!-- The "..." buttons that sit next to a field, as on the activity-shortcut screen. The
         AppCompat coloured button that screen used before was compact: 6dp of vertical inset
         inside the 48dp touch target, so the drawn shape was 36dp tall, with 8dp of padding
         around the text. The Material 3 button that replaced it carries 24dp of horizontal
         padding, and on this row the weight arithmetic leaves the button about 63dp wide - so
         the three dots no longer fitted, wrapped onto a second line, and the button grew tall
         instead of staying level with the field. These numbers put the box back, and maxLines
         keeps the ellipsis horizontal whatever the width does later. -->
    <style name="Widget.App.Button.Compact" parent="Widget.App.Button">
        <item name="android:insetTop">6dp</item>
        <item name="android:insetBottom">6dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:maxLines">1</item>
    </style>

    <!-- Popups and menus: one drawable for every theme. Its colour is ?attr/colorSurface, which
         resolves against the theme of the activity that opens the menu - that is, against the
         in-app switch. A night-qualified drawable or a second palette would follow the system
         instead, which is how dark menus used to come out light (or merged with the background)
         on a phone whose system was in the other mode. -->
    <style name="Widget.App.PopupMenu" parent="Widget.AppCompat.PopupMenu">
        <item name="android:popupBackground">@drawable/rounded_popup_menu</item>
    </style>

    <style name="Widget.App.ListPopup" parent="Widget.AppCompat.ListPopupWindow">
        <item name="android:popupBackground">@drawable/rounded_popup_menu</item>
    </style>

    <style name="Widget.App.Overflow" parent="Widget.AppCompat.PopupMenu.Overflow">
        <item name="android:popupBackground">@drawable/rounded_popup_menu</item>
    </style>

    <!-- A brighter, home-only version. Settings menus keep the regular style; dialogs use their own overlay. -->
    <style name="Widget.App.PopupMenu.Main" parent="Widget.App.PopupMenu">
        <item name="android:popupBackground">@drawable/rounded_main_popup_menu</item>
    </style>

    <style name="Widget.App.ListPopup.Main" parent="Widget.App.ListPopup">
        <item name="android:popupBackground">@drawable/rounded_main_popup_menu</item>
    </style>

    <style name="Widget.App.Overflow.Main" parent="Widget.App.Overflow">
        <item name="android:popupBackground">@drawable/rounded_main_popup_menu</item>
    </style>

    <!-- PreferenceCategory's framework separator style brings all-caps text and a private divider
         background. Rebuild it so section labels follow the app type scale and sit cleanly inside
         the rounded preference-group cards. -->
    <style name="Widget.App.ListSeparator" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:textColor">?android:attr/textColorSecondary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textAppearance">@style/TextAppearance.App.TitleSmall</item>
    </style>

    <!-- Popup and menu item text. The dark themes need a colour of their own here: AppCompat's
         popup item layout takes its title appearance from ?attr/textAppearanceLargePopupMenu, and
         the Material3 appearance it points at carries no colour, so the text falls back to the
         theme's default - which is why the menus read grey next to the dialog labels. Same white
         as the app bar and the dialog actions. -->
    <style name="TextAppearance.App.PopupMenu.Dark" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/appOnDarkSurface</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="fontFamily">sans-serif-condensed</item>
    </style>

    <!-- Material3 draws the dialog itself: rounded, on ?attr/colorSurface, with insets for the
         shadow. What it takes from the theme is the action label colour - ?attr/colorPrimary -
         and the dark palettes below are near black there, which is how "Cancel" ended up dim on
         a dim dialog. This overlay is what those dialogs are built with; it does not have to wait
         for the activity theme, because the app also has dialogs that are windows of their own. -->
    <!-- The action bar hands its overflow menu - and every submenu opened from it - the theme in
         ?attr/actionBarPopupTheme. Material3 points that at ThemeOverlay.Material3.Dark, a full
         colour overlay whose colorSurface is the stock Material surface #1C1B1F, so the three dot
         menu came out darker than the one the "+" button opens with the activity theme. An empty
         overlay keeps the popup on the activity theme, and then every menu in the app is painted
         by the palette of the theme that opened it. -->
    <style name="ThemeOverlay.App.ActionBarPopup" parent="" />

    <!-- Main-page popups opt in; Settings keeps the shared popup surface. -->
    <style name="ThemeOverlay.App.Popup.Main.Light" parent="ThemeOverlay.App.ActionBarPopup">
        <item name="colorSurface">@color/appMainPopupLight</item>
        <item name="popupMenuStyle">@style/Widget.App.PopupMenu.Main</item>
        <item name="listPopupWindowStyle">@style/Widget.App.ListPopup.Main</item>
        <item name="actionOverflowMenuStyle">@style/Widget.App.Overflow.Main</item>
    </style>

    <!-- The app bar carries its own title colour. Material3 leaves the title to the default text
         colour, which on a dark theme is dimmer than the icons next to it; here it is the same
         near white as the icons. -->
    <style name="Widget.App.Toolbar.Dark" parent="Widget.Material3.Toolbar">
        <item name="titleTextColor">@color/appOnDarkSurface</item>
        <item name="subtitleTextColor">@color/appOnDarkSurface</item>
    </style>

    <!-- Material3 applies a surface/elevation tint to MaterialAlertDialog shapes, while the
         popup menus use a flat colorSurface drawable. Disable that tint so both surfaces have
         the same palette colour. -->
    <style name="ThemeOverlay.App.Dialog.Dark" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="elevationOverlayEnabled">false</item>
        <item name="colorPrimary">@color/appOnDarkSurface</item>
    </style>

    <style name="ThemeOverlay.App.Dialog.Light" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <!-- Match the flat popup surface and blue action accent even when a versioned screen theme
             replaces its base style or the legacy light leaf uses a different colorAccent. -->
        <item name="colorSurface">@color/appSurfaceLight</item>
        <item name="elevationOverlayEnabled">false</item>
        <item name="colorPrimary">@color/appAccent</item>
    </style>

    <!-- Main-page dialogs follow its popup tone; the Settings dialog overlay stays unchanged. -->
    <style name="ThemeOverlay.App.Dialog.Main.Light" parent="ThemeOverlay.App.Dialog.Light">
        <item name="colorSurface">@color/appMainPopupLight</item>
    </style>

    <style name="Base.AppTheme.Translucent.NoTitleBar.Core" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="textAppearanceDisplayLarge">@style/TextAppearance.App.DisplayLarge</item>
        <item name="textAppearanceDisplayMedium">@style/TextAppearance.App.DisplayMedium</item>
        <item name="textAppearanceDisplaySmall">@style/TextAppearance.App.DisplaySmall</item>
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.App.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.App.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.App.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.App.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.App.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.App.TitleSmall</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.App.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.App.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.App.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.App.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.App.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.App.LabelSmall</item>
    </style>

        <!-- The app-wide typeface. This base is the one theme that is not given a values-v26
             leaf of its own: values-v19 and values-v21 redefine it with an outside parent, so
             at API 19 and up the most specific definition of this name wins and this leaf is
             not it. Adding a v26 leaf here would take the theme back over on 26+ and hand its
             eight activities their Material3 attributes - a fix, but a different one, and it
             has to be made on purpose. Until then the font is only missing on 19+, as it was. -->
    <style name="Base.AppTheme.Translucent.NoTitleBar" parent="Base.AppTheme.Translucent.NoTitleBar.Core">
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="fontFamily">sans-serif-condensed</item>
    </style>

    <style name="AppTheme.Translucent.NoTitleBar" parent="Base.AppTheme.Translucent.NoTitleBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
    </style>

    <!--
        Theme families.

        Every one of them is Material 3, on every API level. There are deliberately no
        values-v21/v23 variants of these names any more: a style with the same name in a
        qualifier folder replaces the base one wholesale, so the AppCompat parents those
        folders declared silently dropped every Material3 item - surfaces, shapes, popup and
        dialog styles - on every device from API 21 up, which is every device. The version
        gated items that are still wanted (navigation bar colour, light status bar) live in the
        styles below; a platform that does not know an attribute simply ignores it.

        Dark and black differ in their palette and in nothing else:
          dark  - a dark grey screen (#1E1F22) with lighter grey containers (#35383E);
          black - a pure black screen (#000000) with dim containers (#22252A), for AMOLED.
        Screen and container are the same colours the settings screens paint themselves with,
        so the toolbar, the settings cards, the menus and the dialogs of one theme agree.

        colorAccent is kept as the app's accent: it is what the action buttons are tinted with,
        and it is set per palette in the AppTheme.* styles below.
    -->
    <style name="Base.AppTheme.Dark.Core" parent="Theme.Material3.Dark">
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.App.Dialog.Dark</item>
        <item name="actionButtonStyle">@style/FreezeYou.ActionButton</item>
        <item name="popupMenuStyle">@style/Widget.App.PopupMenu</item>
        <item name="listPopupWindowStyle">@style/Widget.App.ListPopup</item>
        <item name="actionOverflowMenuStyle">@style/Widget.App.Overflow</item>
        <item name="android:colorBackground">@color/appScreenDark</item>
        <item name="colorSurface">@color/appSurfaceDark</item>
        <!-- The default Material3 text appearances inherit AppCompat and do not set a color;
             ordinary TextViews and AndroidX Preference therefore read these framework attrs. -->
        <item name="colorOnSurfaceVariant">@color/appOnDarkSurfaceVariant</item>
        <item name="android:textColorPrimary">@color/app_dark_text_primary</item>
        <item name="android:textColorSecondary">@color/app_dark_text_secondary</item>
        <item name="android:textColorHint">@color/app_dark_text_secondary</item>
        <item name="appListPackageTextColor">@color/app_dark_text_secondary</item>
        <item name="android:navigationBarColor">?attr/colorPrimaryDark</item>
        <item name="android:dialogCornerRadius">16dp</item>
        <item name="shapeAppearanceSmallComponent">@style/Shape.App.Small</item>
        <item name="actionBarPopupTheme">@style/ThemeOverlay.App.ActionBarPopup</item>
        <item name="toolbarStyle">@style/Widget.App.Toolbar.Dark</item>
        <item name="colorControlNormal">@color/appOnDarkSurface</item>
        <item name="colorPrimary">@color/appOnDarkSurface</item>
        <item name="colorOnPrimary">@color/appScreenDark</item>
        <item name="textAppearanceLargePopupMenu">@style/TextAppearance.App.PopupMenu.Dark</item>
        <item name="textAppearanceSmallPopupMenu">@style/TextAppearance.App.PopupMenu.Dark</item>
        <item name="actionMenuTextColor">@color/appOnDarkSurface</item>
        <item name="textAppearanceDisplayLarge">@style/TextAppearance.App.DisplayLarge</item>
        <item name="textAppearanceDisplayMedium">@style/TextAppearance.App.DisplayMedium</item>
        <item name="textAppearanceDisplaySmall">@style/TextAppearance.App.DisplaySmall</item>
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.App.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.App.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.App.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.App.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.App.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.App.TitleSmall</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.App.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.App.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.App.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.App.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.App.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.App.LabelSmall</item>
        <item name="android:textAppearanceSmall">@style/TextAppearance.App.BodySmall</item>
        <item name="android:textAppearanceLarge">@style/TextAppearance.App.TitleMedium</item>
        <item name="android:listSeparatorTextViewStyle">@style/Widget.App.ListSeparator</item>
    </style>

        <!-- The app-wide typeface, and the only thing about these themes that differs by API
             level. It lives in a style of its own because a same-named style in a version
             folder replaces this one entirely: the rest of the theme stays in the .Core style
             above, and values-v26 repoints just the font at the bundled family. -->
    <style name="Base.AppTheme.Dark" parent="Base.AppTheme.Dark.Core">
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="fontFamily">sans-serif-condensed</item>
    </style>

    <style name="AppTheme.Dark.Default" parent="Base.AppTheme.Dark">
        <item name="colorPrimaryDark">#000000</item>
        <item name="colorAccent">@color/appAccent</item>
    </style>

    <style name="Base.AppTheme.Dark.Black" parent="Base.AppTheme.Dark">
        <item name="android:colorBackground">@color/appScreenBlack</item>
        <item name="colorSurface">@color/appSurfaceBlack</item>
        <item name="colorOnPrimary">@color/appScreenBlack</item>
    </style>

    <style name="AppTheme.Dark.Black" parent="Base.AppTheme.Dark.Black">
        <item name="colorPrimaryDark">#000000</item>
        <item name="colorAccent">@color/appAccent</item>
        <item name="colorBackgroundFloating">@android:color/black</item>
        <item name="android:windowBackground">@color/appScreenBlack</item>
        <item name="android:colorBackground">@color/appScreenBlack</item>
    </style>

    <!-- The two light bases carry the same items; a style can have only one parent, and the
         ActionBar / no ActionBar variants have to stay separate names. -->
    <style name="Base.AppTheme.Light.DarkActionBar.Core" parent="Theme.Material3.Light">
        <!-- Material3 fills the legacy AppCompat accent from its grey-purple colorSecondary.
             Keep this core's accent blue; the explicit dialog overlay below also keeps alert
             actions blue when a light leaf theme overrides colorAccent. -->
        <item name="colorAccent">@color/appAccent</item>
        <!-- The light family's own pair, declared the way the dark ones declare theirs. Without
             these two the theme inherited Material3's near white for both the screen and the
             dialogs, and the settings screens - which paint themselves from values/colors.xml -
             were the only light surfaces in the app that were not blinding. -->
        <item name="android:colorBackground">@color/appScreenLight</item>
        <item name="colorSurface">@color/appSurfaceLight</item>
        <item name="appListPackageTextColor">?android:attr/textColorPrimary</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.App.Dialog.Light</item>
        <item name="actionButtonStyle">@style/FreezeYou.ActionButton</item>
        <item name="popupMenuStyle">@style/Widget.App.PopupMenu</item>
        <item name="listPopupWindowStyle">@style/Widget.App.ListPopup</item>
        <item name="actionOverflowMenuStyle">@style/Widget.App.Overflow</item>
        <item name="android:navigationBarColor">?attr/colorPrimaryDark</item>
        <!-- No android:windowLightStatusBar here: this family's bar is the dark one. On Android
             12+ it is the Material 3 purple that arrives through colorPrimaryDark = colorPrimary,
             below that it is the app accent, and dark icons on it were the unreadable pair the
             owner saw next to the original application, where they are white. The light grey bar
             of AppTheme.Default asks for dark icons in its own style. -->
        <item name="android:dialogCornerRadius">16dp</item>
        <item name="shapeAppearanceSmallComponent">@style/Shape.App.Small</item>
        <item name="actionBarPopupTheme">@style/ThemeOverlay.App.ActionBarPopup</item>
        <item name="textAppearanceDisplayLarge">@style/TextAppearance.App.DisplayLarge</item>
        <item name="textAppearanceDisplayMedium">@style/TextAppearance.App.DisplayMedium</item>
        <item name="textAppearanceDisplaySmall">@style/TextAppearance.App.DisplaySmall</item>
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.App.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.App.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.App.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.App.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.App.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.App.TitleSmall</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.App.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.App.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.App.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.App.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.App.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.App.LabelSmall</item>
        <item name="android:textAppearanceSmall">@style/TextAppearance.App.BodySmall</item>
        <item name="android:textAppearanceLarge">@style/TextAppearance.App.TitleMedium</item>
        <item name="android:listSeparatorTextViewStyle">@style/Widget.App.ListSeparator</item>
        <item name="textAppearanceLargePopupMenu">@style/TextAppearance.App.PopupMenu.Light</item>
        <item name="textAppearanceSmallPopupMenu">@style/TextAppearance.App.PopupMenu.Light</item>
    </style>

