<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- 12 dp corners: buttons and other small components. -->
    <style name="Shape.App.Small" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <!-- Tighter than the AppCompat default so 4 toolbar action icons can fit on more screens
         without shrinking below the ~40dp accessibility-friendly touch target. -->
    <style name="FreezeYou.ActionButton" parent="Widget.AppCompat.ActionButton">
        <item name="android:minWidth">40dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
    </style>

    <!-- Filled action buttons, including the six on the backup screen. They used to carry
         Widget.AppCompat.Button.Colored: that style sets android:background, and a Button in a
         Material theme is inflated as MaterialButton, which then treats the background as
         user-supplied and keeps the AppCompat shape - a rectangle with a 2 dp radius, whatever
         shapeAppearance says. Styling MaterialButton itself is what actually rounds it.

         The insets are part of the look, not a detail to optimise away. MaterialButton insets
         the fill from the edges of the touch target, and that inset is what separates two
         buttons that sit next to each other; zeroing it made the fills touch and read as one
         long bar. Top and bottom keep the Material3 default (m3_btn_inset, 4 dp), which is what
         separates the stacked buttons on the backup screen. Left and right are set here because
         every row of buttons in this app is a weight-split LinearLayout with no margins. -->
    <style name="Widget.App.Button" parent="Widget.Material3.Button">
        <item name="shapeAppearance">@style/Shape.App.Small</item>
        <item name="backgroundTint">?attr/colorAccent</item>
        <item name="android:textColor">@color/app_button_text</item>
        <item name="android:insetLeft">4dp</item>
        <item name="android:insetRight">4dp</item>
    </style>

    <!-- Popups and menus: one drawable for every theme. Its colour is ?attr/colorSurface, which
         resolves against the theme of the activity that opens the menu - that is, against the
         in-app switch. A night-qualified drawable or a second palette would follow the system
         instead, which is how dark menus used to come out light (or merged with the background)
         on a phone whose system was in the other mode. -->
    <style name="Widget.App.PopupMenu" parent="Widget.AppCompat.PopupMenu">
        <item name="android:popupBackground">@drawable/rounded_popup_menu</item>
    </style>

    <style name="Widget.App.ListPopup" parent="Widget.AppCompat.ListPopupWindow">
        <item name="android:popupBackground">@drawable/rounded_popup_menu</item>
    </style>

    <style name="Widget.App.Overflow" parent="Widget.AppCompat.PopupMenu.Overflow">
        <item name="android:popupBackground">@drawable/rounded_popup_menu</item>
    </style>

    <!-- Material3 draws the dialog itself: rounded, on ?attr/colorSurface, with insets for the
         shadow. What it takes from the theme is the action label colour - ?attr/colorPrimary -
         and the dark palettes below are near black there, which is how "Cancel" ended up dim on
         a dim dialog. This overlay is what those dialogs are built with; it does not have to wait
         for the activity theme, because the app also has dialogs that are windows of their own. -->
    <!-- The action bar hands its overflow menu - and every submenu opened from it - the theme in
         ?attr/actionBarPopupTheme. Material3 points that at ThemeOverlay.Material3.Dark, a full
         colour overlay whose colorSurface is the stock Material surface #1C1B1F, so the three dot
         menu came out darker than the one the "+" button opens with the activity theme. An empty
         overlay keeps the popup on the activity theme, and then every menu in the app is painted
         by the palette of the theme that opened it. -->
    <style name="ThemeOverlay.App.ActionBarPopup" parent="" />

    <!-- The app bar carries its own title colour. Material3 leaves the title to the default text
         colour, which on a dark theme is dimmer than the icons next to it; here it is the same
         near white as the icons. -->
    <style name="Widget.App.Toolbar.Dark" parent="Widget.Material3.Toolbar">
        <item name="titleTextColor">@color/appOnDarkSurface</item>
        <item name="subtitleTextColor">@color/appOnDarkSurface</item>
    </style>

    <style name="ThemeOverlay.App.Dialog.Dark" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">@color/appOnDarkSurface</item>
    </style>

    <style name="ThemeOverlay.App.Dialog.Light" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">?attr/colorAccent</item>
    </style>

    <style name="Base.AppTheme.Translucent.NoTitleBar" parent="Theme.Material3.DayNight.NoActionBar" />

    <style name="AppTheme.Translucent.NoTitleBar" parent="Base.AppTheme.Translucent.NoTitleBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
    </style>

    <!--
        Theme families.

        Every one of them is Material 3, on every API level. There are deliberately no
        values-v21/v23 variants of these names any more: a style with the same name in a
        qualifier folder replaces the base one wholesale, so the AppCompat parents those
        folders declared silently dropped every Material3 item - surfaces, shapes, popup and
        dialog styles - on every device from API 21 up, which is every device. The version
        gated items that are still wanted (navigation bar colour, light status bar) live in the
        styles below; a platform that does not know an attribute simply ignores it.

        Dark and black differ in their palette and in nothing else:
          dark  - a dark grey screen (#1E1F22) with lighter grey containers (#35383E);
          black - a pure black screen (#000000) with dim containers (#22252A), for AMOLED.
        Screen and container are the same colours the settings screens paint themselves with,
        so the toolbar, the settings cards, the menus and the dialogs of one theme agree.

        colorAccent is kept as the app's accent: it is what the action buttons are tinted with,
        and it is set per palette in the AppTheme.* styles below.
    -->
    <style name="Base.AppTheme.Dark" parent="Theme.Material3.Dark">
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.App.Dialog.Dark</item>
        <item name="actionButtonStyle">@style/FreezeYou.ActionButton</item>
        <item name="popupMenuStyle">@style/Widget.App.PopupMenu</item>
        <item name="listPopupWindowStyle">@style/Widget.App.ListPopup</item>
        <item name="actionOverflowMenuStyle">@style/Widget.App.Overflow</item>
        <item name="android:colorBackground">@color/appScreenDark</item>
        <item name="colorSurface">@color/appSurfaceDark</item>
        <item name="android:navigationBarColor">?attr/colorPrimaryDark</item>
        <item name="android:dialogCornerRadius">16dp</item>
        <item name="shapeAppearanceSmallComponent">@style/Shape.App.Small</item>
        <item name="actionBarPopupTheme">@style/ThemeOverlay.App.ActionBarPopup</item>
        <item name="toolbarStyle">@style/Widget.App.Toolbar.Dark</item>
        <item name="colorControlNormal">@color/appOnDarkSurface</item>
        <item name="colorPrimary">@color/appOnDarkSurface</item>
        <item name="colorOnPrimary">@color/appScreenDark</item>
    </style>

    <style name="AppTheme.Dark.Default" parent="Base.AppTheme.Dark">
        <item name="colorPrimaryDark">#000000</item>
        <item name="colorAccent">@color/appAccent</item>
    </style>

    <style name="Base.AppTheme.Dark.Black" parent="Base.AppTheme.Dark">
        <item name="android:colorBackground">@color/appScreenBlack</item>
        <item name="colorSurface">@color/appSurfaceBlack</item>
        <item name="colorOnPrimary">@color/appScreenBlack</item>
    </style>

    <style name="AppTheme.Dark.Black" parent="Base.AppTheme.Dark.Black">
        <item name="colorPrimaryDark">#000000</item>
        <item name="colorAccent">@color/appAccent</item>
        <item name="colorBackgroundFloating">@android:color/black</item>
        <item name="android:windowBackground">@color/appScreenBlack</item>
        <item name="android:colorBackground">@color/appScreenBlack</item>
    </style>

    <!-- The two light bases carry the same items; a style can have only one parent, and the
         ActionBar / no ActionBar variants have to stay separate names. -->
    <style name="Base.AppTheme.Light.DarkActionBar" parent="Theme.Material3.Light">
        <!-- Material3 keeps the AppCompat accent attribute, but fills it with its own
             ?attr/colorSecondary, which is the grey purple the filled buttons and the dialog
             labels would come out in. Point it back at the app blue. -->
        <item name="colorAccent">@color/appAccent</item>
        <item name="actionButtonStyle">@style/FreezeYou.ActionButton</item>
        <item name="popupMenuStyle">@style/Widget.App.PopupMenu</item>
        <item name="listPopupWindowStyle">@style/Widget.App.ListPopup</item>
        <item name="actionOverflowMenuStyle">@style/Widget.App.Overflow</item>
        <item name="android:navigationBarColor">?attr/colorPrimaryDark</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:dialogCornerRadius">16dp</item>
        <item name="shapeAppearanceSmallComponent">@style/Shape.App.Small</item>
        <item name="actionBarPopupTheme">@style/ThemeOverlay.App.ActionBarPopup</item>
    </style>

    <style name="Base.AppTheme.Light" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorAccent">@color/appAccent</item>
        <item name="actionButtonStyle">@style/FreezeYou.ActionButton</item>
        <item name="popupMenuStyle">@style/Widget.App.PopupMenu</item>
        <item name="listPopupWindowStyle">@style/Widget.App.ListPopup</item>
        <item name="actionOverflowMenuStyle">@style/Widget.App.Overflow</item>
        <item name="android:navigationBarColor">?attr/colorPrimaryDark</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:dialogCornerRadius">16dp</item>
        <item name="shapeAppearanceSmallComponent">@style/Shape.App.Small</item>
        <item name="actionBarPopupTheme">@style/ThemeOverlay.App.ActionBarPopup</item>
    </style>

    <style name="AppTheme.Light.Blue" parent="Base.AppTheme.Light.DarkActionBar">
        <item name="colorPrimaryDark">#026FDE</item>
        <item name="colorPrimary">#0383E9</item>
        <item name="colorAccent">#0300EF</item>
    </style>

    <style name="AppTheme.Light.Yellow" parent="Base.AppTheme.Light.DarkActionBar">
        <item name="colorPrimaryDark">#f7a500</item>
        <item name="colorPrimary">#ffbf00</item>
        <item name="colorAccent">#ffbf00</item>
    </style>

    <style name="AppTheme.Light.Orange" parent="Base.AppTheme.Light.DarkActionBar">
        <item name="colorPrimaryDark">#c43e00</item>
        <item name="colorPrimary">#ff6f00</item>
        <item name="colorAccent">#ff5500</item>
    </style>

    <style name="AppTheme.Light.Green" parent="Base.AppTheme.Light.DarkActionBar">
        <item name="colorPrimaryDark">#009624</item>
        <item name="colorPrimary">#00c853</item>
        <item name="colorAccent">#00aa00</item>
    </style>

    <style name="AppTheme.Light.Pink" parent="Base.AppTheme.Light.DarkActionBar">
        <item name="colorPrimaryDark">#ec407a</item>
        <item name="colorPrimary">#FF4081</item>
        <item name="colorAccent">#FF4081</item>
    </style>

    <style name="AppTheme.Light.Red" parent="Base.AppTheme.Light.DarkActionBar">
        <item name="colorPrimaryDark">#9b0000</item>
        <item name="colorPrimary">#d50000</item>
        <item name="colorAccent">#d50000</item>
    </style>

    <!-- colorPrimary is nearly white here, so Material dialogs would print their action labels in
         it and they would be invisible on a light dialog; the overlay replaces that one colour
         with the accent. The palette is only reachable on API < 31 - from Android 12 on,
         AppTheme.Default is the Material3 light theme (see values-v31). -->
    <style name="AppTheme.Light.White" parent="Base.AppTheme.Light">
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.App.Dialog.Light</item>
        <item name="colorPrimaryDark">#eeeeee</item>
        <item name="colorPrimary">#fafafa</item>
        <item name="colorAccent">#424242</item>
    </style>

    <style name="AppTheme.Default" parent="AppTheme.Light.White" />

    <style name="Base.AppTheme.Dark.Dialog" parent="Theme.Material3.Dark.Dialog">
        <item name="windowNoTitle">true</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.App.Dialog.Dark</item>
        <item name="colorSurface">@color/appSurfaceDark</item>
        <item name="android:dialogCornerRadius">16dp</item>
        <item name="colorPrimary">@color/appOnDarkSurface</item>
        <item name="colorOnPrimary">@color/appScreenDark</item>
    </style>

    <style name="AppTheme.Dark.Dialog.Default" parent="Base.AppTheme.Dark.Dialog">
        <item name="colorPrimaryDark">#000000</item>
        <item name="colorAccent">@color/appAccent</item>
    </style>

    <!-- Not "V14" for any platform reason: this is the black palette of the dark dialog theme,
         which the black dialog theme and AppTheme.Dark.Dialog.Black build on. -->
    <style name="Base.V14.AppTheme.Dark.Dialog" parent="Base.AppTheme.Dark.Dialog">
        <item name="colorBackgroundFloating">@android:color/black</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="colorSurface">@color/appSurfaceBlack</item>
        <item name="colorOnPrimary">@color/appScreenBlack</item>
    </style>

    <style name="Base.AppTheme.Dark.Dialog.Black" parent="Base.V14.AppTheme.Dark.Dialog" />

    <style name="AppTheme.Dark.Dialog.Black" parent="Base.AppTheme.Dark.Dialog.Black">
        <item name="colorPrimaryDark">#000000</item>
        <item name="colorAccent">@color/appAccent</item>
    </style>

    <style name="Base.AppTheme.Light.Dialog" parent="Theme.Material3.Light.Dialog">
        <item name="windowNoTitle">true</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.App.Dialog.Light</item>
        <item name="android:dialogCornerRadius">16dp</item>
    </style>

    <style name="AppTheme.Light.Dialog.Blue" parent="Base.AppTheme.Light.Dialog">
        <item name="colorPrimaryDark">#026FDE</item>
        <item name="colorPrimary">#0383E9</item>
        <item name="colorAccent">#0300EF</item>
    </style>

    <style name="AppTheme.Light.Dialog.Yellow" parent="Base.AppTheme.Light.Dialog">
        <item name="colorPrimaryDark">#f7a500</item>
        <item name="colorPrimary">#ffbf00</item>
        <item name="colorAccent">#ffbf00</item>
    </style>

    <style name="AppTheme.Light.Dialog.Orange" parent="Base.AppTheme.Light.Dialog">
        <item name="colorPrimaryDark">#c43e00</item>
        <item name="colorPrimary">#ff6f00</item>
        <item name="colorAccent">#ff5500</item>
    </style>

    <style name="AppTheme.Light.Dialog.Green" parent="Base.AppTheme.Light.Dialog">
        <item name="colorPrimaryDark">#009624</item>
        <item name="colorPrimary">#00c853</item>
        <item name="colorAccent">#00aa00</item>
    </style>

    <style name="AppTheme.Light.Dialog.Pink" parent="Base.AppTheme.Light.Dialog">
        <item name="colorPrimaryDark">#ec407a</item>
        <item name="colorPrimary">#FF4081</item>
        <item name="colorAccent">#FF4081</item>
    </style>

    <style name="AppTheme.Light.Dialog.Red" parent="Base.AppTheme.Light.Dialog">
        <item name="colorPrimaryDark">#9b0000</item>
        <item name="colorPrimary">#d50000</item>
        <item name="colorAccent">#d50000</item>
    </style>

    <style name="AppTheme.Light.Dialog.White" parent="Base.AppTheme.Light.Dialog">
        <item name="colorPrimaryDark">#eeeeee</item>
        <item name="colorPrimary">#fafafa</item>
        <item name="colorAccent">#424242</item>
    </style>

    <style name="AppTheme.Default.Dialog" parent="AppTheme.Light.Dialog.White" />

    <style name="Base.AppTheme.SplashScreen" parent="Base.V14.AppTheme.SplashScreen" />

    <style name="Base.V14.AppTheme.SplashScreen" parent="AppTheme.Dark.Default" />

    <style name="AppTheme.SplashScreen" parent="Base.AppTheme.SplashScreen" />

</resources>
