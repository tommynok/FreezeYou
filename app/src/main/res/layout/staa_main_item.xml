<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/staa_main_item_imageView"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="5dp"
        android:layout_marginLeft="5dp"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="5dp"
        android:contentDescription="@string/icon"
        android:scaleType="fitCenter"
        app:srcCompat="@mipmap/ic_launcher_new_round" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="5dp"
        android:orientation="vertical">

        <!-- Heights were fixed at 20dp/18dp while maxLines allowed two lines: a second line
             had nowhere to go and was cut in half. Fully qualified activity names are long
             enough to wrap constantly, so the rows size to their content instead.
             scrollHorizontally is gone because it asks the text not to wrap at all, which
             contradicts the wrapping these rows depend on. -->
        <TextView
            android:id="@+id/staa_main_item_textView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/staa_main_item_subtitle_textView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="3"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>