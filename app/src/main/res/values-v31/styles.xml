<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Base.V31.AppTheme.SplashScreen" parent="Base.V14.AppTheme.SplashScreen">
        <item name="android:windowSplashScreenAnimatedIcon">
            @drawable/ic_launcher_new_round_foreground
        </item>
        <item name="android:windowSplashScreenBackground">?attr/colorControlNormal</item>
        <item name="android:windowSplashScreenIconBackgroundColor">#1565C0</item>
    </style>

    <style name="Base.AppTheme.SplashScreen" parent="Base.V31.AppTheme.SplashScreen" />

    <!-- Android 12+. The light default used to be defined here instead of in values/ precisely
         because below 31 there was an AppCompat theme with the same name; that is gone, so this
         only adds what is really 31+ - and it now shares the popup, button and surface items
         with the other light themes through Base.AppTheme.Light.DarkActionBar.
         Always light: the upstream DayNight parent made "Default" follow the system dark mode,
         which the owner experienced as the light option disappearing. -->
    <style name="AppTheme.Default" parent="Base.AppTheme.Light.DarkActionBar">
        <item name="android:dialogCornerRadius">16dp</item>
    </style>

    <style name="AppTheme.Default.Dialog" parent="Theme.Material3.Light">
        <item name="android:dialogCornerRadius">16dp</item>
        <!-- The typeface block, repeated for the same reason the popup styles below are repeated:
             this theme's parent is an outside Material3 one, so it inherits none of ours. Without
             these the light dialogs on Android 12+ were the one surface in the app still set in the
             system regular - title, message and action labels - while every screen behind them was
             condensed. -->
        <item name="android:fontFamily">@font/roboto_condensed</item>
        <item name="fontFamily">@font/roboto_condensed</item>
        <item name="textAppearanceDisplayLarge">@style/TextAppearance.App.DisplayLarge</item>
        <item name="textAppearanceDisplayMedium">@style/TextAppearance.App.DisplayMedium</item>
        <item name="textAppearanceDisplaySmall">@style/TextAppearance.App.DisplaySmall</item>
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.App.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.App.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.App.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.App.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.App.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.App.TitleSmall</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.App.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.App.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.App.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.App.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.App.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.App.LabelSmall</item>
        <item name="textAppearanceLargePopupMenu">@style/TextAppearance.App.PopupMenu.Light</item>
        <item name="textAppearanceSmallPopupMenu">@style/TextAppearance.App.PopupMenu.Light</item>
        <!-- This theme's parent is an outside Material3 one, so it does not inherit the pair from
             Base.AppTheme.Light.Dialog the way it does below API 31. A dialog is a container, and
             the container is the colour the Material dialog paints itself with. -->
        <item name="colorSurface">@color/appSurfaceLight</item>
        <item name="shapeAppearanceSmallComponent">@style/Shape.App.Small</item>
        <item name="colorAccent">@color/appAccent</item>
        <!-- This theme replaces Base.AppTheme.Light.Dialog on Android 12+, and it is the only
             dialog theme here whose parent is an outside Material3 theme rather than ours, so it
             does not inherit materialAlertDialogTheme. Dialogs are built with
             MaterialAlertDialogBuilder, which reads exactly that attribute for its action labels;
             without it they fall back to the Material3 default overlay and print in the baseline
             purple instead of the app's accent. Same overlay the other light dialog themes use. -->
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.App.Dialog.Light</item>
        <item name="actionOverflowMenuStyle">@style/Widget.App.Overflow</item>
        <item name="popupMenuStyle">@style/Widget.App.PopupMenu</item>
        <item name="listPopupWindowStyle">@style/Widget.App.ListPopup</item>
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="windowActionModeOverlay">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowElevation">@dimen/abc_floating_window_z</item>
    </style>

</resources>
