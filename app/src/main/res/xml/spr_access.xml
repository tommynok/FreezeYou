<?xml version="1.0" encoding="utf-8"?><!--
    Everything that answers one question: how the application is entered, and by whom. The lock
    was a screen of its own holding a single checkbox; the launcher icons and the dialer code were
    another. Hiding from the recents list is here too — it is privacy, not a general preference.
-->
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:title="@string/security">

        <!-- Hidden on purpose: the visible selector below writes this key, and the lock rows
             keep their XML dependency on it. -->
        <CheckBoxPreference
            app:defaultValue="false"
            app:iconSpaceReserved="false"
            app:isPreferenceVisible="false"
            app:key="enableAuthentication" />
        <Preference
            app:iconSpaceReserved="false"
            app:key="authenticationMethod"
            app:singleLineTitle="false"
            app:title="@string/authenticationMethod" />
        <CheckBoxPreference
            app:defaultValue="true"
            app:dependency="enableAuthentication"
            app:iconSpaceReserved="false"
            app:key="lockOnEntry"
            app:singleLineTitle="false"
            app:summary="@string/summary_lockOnEntry"
            app:title="@string/lockOnEntry" />
        <CheckBoxPreference
            app:defaultValue="true"
            app:dependency="enableAuthentication"
            app:iconSpaceReserved="false"
            app:key="protectShortcuts"
            app:singleLineTitle="false"
            app:summary="@string/summary_protectShortcuts"
            app:title="@string/protectShortcuts" />
        <ListPreference
            app:defaultValue="900000"
            app:dependency="enableAuthentication"
            app:entries="@array/appLockTimeoutSelection"
            app:entryValues="@array/appLockTimeoutSelectionValues"
            app:iconSpaceReserved="false"
            app:key="appLockTimeout"
            app:singleLineTitle="false"
            app:title="@string/appLockTimeout"
            app:useSimpleSummaryProvider="true" />
        <CheckBoxPreference
            app:defaultValue="false"
            app:dependency="enableAuthentication"
            app:iconSpaceReserved="false"
            app:key="lockOnScreenOff"
            app:singleLineTitle="false"
            app:summary="@string/summary_lockOnScreenOff"
            app:title="@string/lockOnScreenOff" />
        <Preference
            app:iconSpaceReserved="false"
            app:key="deviceAdminProtection"
            app:singleLineTitle="false"
            app:summary="@string/summary_deviceAdminProtection"
            app:title="@string/deviceAdminProtection" />
        <CheckBoxPreference
            app:defaultValue="true"
            app:disableDependentsState="false"
            app:iconSpaceReserved="false"
            app:key="showInRecents"
            app:singleLineTitle="false"
            app:summary="@string/showInRecentsSummary"
            app:title="@string/showInRecents" />
        <CheckBoxPreference
            app:defaultValue="false"
            app:dependency="showInRecents"
            app:iconSpaceReserved="false"
            app:key="includeFUFActivityInRecents"
            app:singleLineTitle="false"
            app:summary="@string/includeFUFActivityInRecentsSummary"
            app:title="@string/includeFUFActivityInRecents" />

    </PreferenceCategory>

    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:title="@string/appLock">

        <CheckBoxPreference
            app:defaultValue="false"
            app:iconSpaceReserved="false"
            app:key="enableAppLock"
            app:singleLineTitle="false"
            app:summary="@string/summary_enableAppLock"
            app:title="@string/enableAppLock" />
        <ListPreference
            app:defaultValue="immediately"
            app:dependency="enableAppLock"
            app:entries="@array/appLockReLockPolicySelection"
            app:entryValues="@array/appLockReLockPolicySelectionValues"
            app:iconSpaceReserved="false"
            app:key="appLockReLockPolicy"
            app:singleLineTitle="false"
            app:title="@string/appLockReLockPolicy"
            app:useSimpleSummaryProvider="true" />
        <CheckBoxPreference
            app:defaultValue="false"
            app:dependency="enableAppLock"
            app:iconSpaceReserved="false"
            app:key="protectSystemSettings"
            app:singleLineTitle="false"
            app:summary="@string/summary_protectSystemSettings"
            app:title="@string/protectSystemSettings" />

    </PreferenceCategory>

    <PreferenceCategory
        app:iconSpaceReserved="false"
        app:title="@string/iconAEntry">

        <CheckBoxPreference
            app:defaultValue="false"
            app:icon="@mipmap/ic_launcher"
            app:iconSpaceReserved="false"
            app:key="firstIconEnabled"
            app:singleLineTitle="false" />
        <CheckBoxPreference
            app:defaultValue="false"
            app:icon="@mipmap/ic_launcher_round"
            app:iconSpaceReserved="false"
            app:key="secondIconEnabled"
            app:singleLineTitle="false" />
        <CheckBoxPreference
            app:defaultValue="true"
            app:icon="@mipmap/ic_launcher_new_round"
            app:iconSpaceReserved="false"
            app:key="thirdIconEnabled"
            app:singleLineTitle="false" />
        <Preference
            app:iconSpaceReserved="false"
            app:singleLineTitle="false"
            app:summary="@string/dialEntry_Ex"
            app:title="@string/dialEntry" />

    </PreferenceCategory>

</PreferenceScreen>
