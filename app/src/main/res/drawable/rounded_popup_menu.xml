<?xml version="1.0" encoding="utf-8"?>
<!-- Rounded background for every app popup. The container-highest tone sits one step
     above the screen surface in both light and dark themes, so the card reads without
     merging into the background. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="16dp" />
    <solid android:color="?attr/colorSurfaceContainerHighest" />
    <padding
        android:bottom="4dp"
        android:top="4dp" />
</shape>
