<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Base.V31.AppTheme.SplashScreen" parent="Base.V14.AppTheme.SplashScreen">
        <item name="android:windowSplashScreenAnimatedIcon">
            @drawable/ic_launcher_new_round_foreground
        </item>
        <item name="android:windowSplashScreenBackground">?attr/colorControlNormal</item>
        <item name="android:windowSplashScreenIconBackgroundColor">#1565C0</item>
    </style>

    <style name="Base.AppTheme.SplashScreen" parent="Base.V31.AppTheme.SplashScreen" />

    <!-- Android 12+. The light default used to be defined here instead of in values/ precisely
         because below 31 there was an AppCompat theme with the same name; that is gone, so this
         only adds what is really 31+ - and it now shares the popup, button and surface items
         with the other light themes through Base.AppTheme.Light.DarkActionBar.
         Always light: the upstream DayNight parent made "Default" follow the system dark mode,
         which the owner experienced as the light option disappearing. -->
    <style name="AppTheme.Default" parent="Base.AppTheme.Light.DarkActionBar">
        <item name="android:dialogCornerRadius">16dp</item>
    </style>

    <style name="AppTheme.Default.Dialog" parent="Theme.Material3.Light">
        <item name="android:dialogCornerRadius">16dp</item>
        <item name="shapeAppearanceSmallComponent">@style/Shape.App.Small</item>
        <item name="colorAccent">@color/appAccent</item>
        <!-- This theme replaces Base.AppTheme.Light.Dialog on Android 12+, and it is the only
             dialog theme here whose parent is an outside Material3 theme rather than ours, so it
             does not inherit materialAlertDialogTheme. Dialogs are built with
             MaterialAlertDialogBuilder, which reads exactly that attribute for its action labels;
             without it they fall back to the Material3 default overlay and print in the baseline
             purple instead of the app's accent. Same overlay the other light dialog themes use. -->
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.App.Dialog.Light</item>
        <item name="actionOverflowMenuStyle">@style/Widget.App.Overflow</item>
        <item name="popupMenuStyle">@style/Widget.App.PopupMenu</item>
        <item name="listPopupWindowStyle">@style/Widget.App.ListPopup</item>
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="windowActionModeOverlay">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowElevation">@dimen/abc_floating_window_z</item>
    </style>

</resources>
